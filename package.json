{
  "name": "zetheta-notification-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Zetheta BE-6B: event-driven financial notification engine with multi-channel delivery",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "tsx watch src/server.ts",
    "start:api": "node dist/src/server.js",
    "start:worker": "node dist/src/workers/main.js",
    "worker": "tsx src/workers/main.ts",
    "migrate": "tsx src/infrastructure/database/migrate.ts latest",
    "migrate:rollback": "tsx src/infrastructure/database/migrate.ts rollback",
    "migrate:prod": "node dist/src/infrastructure/database/migrate.js latest",
    "seed": "tsx scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "postman:generate": "tsx scripts/generate-postman.ts",
    "infra:local": "scripts/local-infra.sh",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand --forceExit",
    "test:e2e": "jest --selectProjects e2e --runInBand --forceExit",
    "test:all": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --coverage --forceExit",
    "secrets:scan": "tsx scripts/scan-secrets.ts",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "smoke": "tsx scripts/smoke-test.ts",
    "load:ingest": "k6 run load-tests/ingestion.js",
    "load:analytics": "k6 run load-tests/analytics.js",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "8.1.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "amqplib": "0.10.9",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "handlebars": "4.7.10",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "jsonwebtoken": "9.0.2",
    "kafkajs": "2.2.4",
    "knex": "3.1.0",
    "luxon": "3.7.2",
    "nodemailer": "10.1.0",
    "pg": "8.16.3",
    "pino": "9.14.0",
    "prom-client": "15.1.3",
    "socket.io": "4.8.1",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/amqplib": "0.10.8",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/luxon": "3.7.1",
    "@types/node": "20.19.25",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.6",
    "@types/smtp-server": "3.5.12",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jest": "30.5.2",
    "prettier": "3.6.2",
    "smtp-server": "3.19.21",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.4",
    "ts-jest": "29.4.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
