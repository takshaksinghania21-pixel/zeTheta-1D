# -----------------------------------------------------------------------------
# Zetheta BE-6B Notification Engine — environment template
# Copy to .env and replace every placeholder. NEVER commit a populated .env.
# Values marked "dev only" must be regenerated for any shared/prod environment.
# -----------------------------------------------------------------------------

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development                      # development | test | production
SERVICE_NAME=zetheta-notification-engine
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info                            # fatal | error | warn | info | debug | trace
TRUST_PROXY=false                         # set to hop count / true behind a load balancer
CORS_ORIGINS=http://localhost:5173        # comma separated allow-list

# --- PostgreSQL (source of truth) ------------------------------------------------
DATABASE_URL=postgres://zetheta:CHANGE_ME@localhost:5432/zetheta
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Redis (caps, rate limits, DND cache, circuit breakers, socket fan-out) ----
REDIS_URL=redis://localhost:6379/0

# --- Kafka (event backbone) -------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=zetheta-notify
KAFKA_TOPIC_PREFIX=zetheta.
KAFKA_EVENT_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_CONSUMER_CONCURRENCY=3
KAFKA_SASL_MECHANISM=                     # empty | plain | scram-sha-256 | scram-sha-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL=false

# --- RabbitMQ (delivery work queues) ---------------------------------------------
RABBITMQ_URL=amqp://zetheta:CHANGE_ME@localhost:5672/zetheta
RABBITMQ_PREFIX=zetheta.
RABBITMQ_PREFETCH=20

# --- Security ----------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_RANDOM
JWT_ISSUER=zetheta-notification-engine
JWT_AUDIENCE=zetheta-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
# 32 random bytes, base64. Encrypts contact details (phone/email/push tokens) at rest.
DATA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
DATA_ENCRYPTION_KEY_ID=k1
# Separate key for blind-index HMACs of contact values (lookup without decryption).
DATA_HASH_KEY=CHANGE_ME_BASE64_32_BYTES

# Rate limits (requests per minute, Redis sliding window)
RATE_LIMIT_STANDARD_PER_MIN=100
RATE_LIMIT_WEBHOOK_PER_MIN=1000
RATE_LIMIT_PREFERENCES_PER_MIN=10

# --- Provider mode ------------------------------------------------------------------
# mock       : deterministic in-process simulators, no network (default for dev/test)
# sandbox    : real provider sandbox/test endpoints using test credentials
# production : real providers; startup FAILS if credentials or webhook secrets are missing
PROVIDER_MODE=mock
# Ordered provider lists per channel (first = primary, rest = failover)
SMS_PROVIDERS=mock-sms-primary,mock-sms-secondary
EMAIL_PROVIDERS=mock-email
PUSH_PROVIDERS=mock-push
WHATSAPP_PROVIDERS=mock-whatsapp
INAPP_PROVIDERS=socketio
PROVIDER_TIMEOUT_MS=5000
# When set, mock providers POST signed delivery receipts here (exercises webhook path)
MOCK_RECEIPT_CALLBACK_URL=
MOCK_RECEIPT_DELAY_MS=250

# Webhook signing (generic HMAC scheme used by mock + SMTP relay callbacks)
WEBHOOK_SIGNING_SECRET=CHANGE_ME_WEBHOOK_SECRET
WEBHOOK_SIGNATURE_REQUIRED=true           # forced to true when NODE_ENV=production
WEBHOOK_TOLERANCE_SECONDS=300

# Twilio (SMS) — use Twilio *test* credentials in sandbox mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_BASE_URL=https://api.twilio.com

# MSG91 (SMS, DLT-registered flow templates required in India)
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=
MSG91_BASE_URL=https://control.msg91.com
MSG91_WEBHOOK_SECRET=

# Email (Nodemailer). For Ethereal create an account at https://ethereal.email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Zetheta Alerts <alerts@example.test>"

# Firebase Cloud Messaging (HTTP v1)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY_BASE64=
FCM_BASE_URL=https://fcm.googleapis.com
FCM_TOKEN_URL=https://oauth2.googleapis.com/token

# WhatsApp Cloud API (Meta test number)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=https://graph.facebook.com

# --- Compliance ----------------------------------------------------------------------
DND_CACHE_TTL_SECONDS=3600
DND_STALE_AFTER_HOURS=24
RETENTION_DAYS=90

# --- Workers ---------------------------------------------------------------------------
OUTBOX_POLL_MS=200
OUTBOX_BATCH_SIZE=200
SCHEDULER_POLL_MS=1000
RETRY_SWEEP_STALE_SECONDS=300

# --- Docker Compose (docker-compose.yml) -------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
# Seed synthetic demo data on startup (development only). Optional fixed credentials:
SEED=false
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
SEED_SERVICE_SECRET=
SEED_DEMO_USER_PASSWORD=
